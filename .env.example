# Copia este archivo como ".env" y llena los valores (el archivo .env NO se sube a git).
# Pídeselos al otro dueño del proyecto por un canal privado (no en grupos ni en el repositorio).

# Supabase (base de datos, usuarios y archivos). La "anon key" es pública por diseño.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps (opcional: sin estas dos el sitio funciona, pero sin mapa ni autocompletado de direcciones)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# NUNCA pongas aquí la "service role key" de Supabase: no se usa en el frontend.
