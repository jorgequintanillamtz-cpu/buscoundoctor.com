{
  "name": "Specialty",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "display_name": {
      "type": "string",
      "title": "Nombre para pacientes (SEO)",
      "description": "C\u00f3mo busca un paciente esta especialidad en internet (ej. 'Ginec\u00f3logo' en vez de 'Ginecolog\u00eda'), al estilo Doctoralia. Se usa en el buscador, t\u00edtulos de p\u00e1gina, meta descripci\u00f3n y tarjetas de doctor. Si queda vac\u00edo, se usa 'name' como respaldo."
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "profession_slug": {
      "type": "string",
      "title": "Slug de profesi\u00f3n (URL)",
      "description": "Nombre de la profesi\u00f3n en singular, sin acentos, para las URLs p\u00fablicas /{profession_slug}/monterrey (ej. 'ginecologo' para Ginecolog\u00eda). No confundir con 'slug', que sigue siendo el identificador interno de la especialidad."
    },
    "icon": {
      "type": "string",
      "title": "\u00cdcono"
    },
    "icon_image_url": {
      "type": "string",
      "title": "Imagen personalizada del icono",
      "description": "Si se sube una imagen, se usa en vez del icono en el circulo de Especialidades mas buscadas en la pagina de inicio."
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n breve"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "parent_specialty_id": {
      "type": "string",
      "title": "Especialidad padre (relaci\u00f3n)",
      "description": "ID de registro de la entidad Specialty. Si est\u00e1 seteado, esta entrada es una subespecialidad de la especialidad indicada."
    }
  },
  "required": [
    "name",
    "slug"
  ]
}