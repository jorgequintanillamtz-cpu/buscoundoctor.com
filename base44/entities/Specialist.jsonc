{
  "name": "Specialist",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Nombre completo"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "profile_photo": {
      "type": "string",
      "title": "Foto de perfil"
    },
    "specialty": {
      "type": "string",
      "title": "Especialidad principal"
    },
    "subspecialty": {
      "type": "string",
      "title": "Subespecialidad"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n larga"
    },
    "years_experience": {
      "type": "number",
      "title": "A\u00f1os de experiencia"
    },
    "rating": {
      "type": "number",
      "title": "Calificaci\u00f3n (0-5)"
    },
    "location": {
      "type": "string",
      "title": "Ubicaci\u00f3n"
    },
    "city": {
      "type": "string",
      "title": "Ciudad"
    },
    "zone": {
      "type": "string",
      "title": "Zona"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "instagram": {
      "type": "string",
      "title": "Instagram"
    },
    "modality": {
      "type": "string",
      "title": "Modalidad",
      "enum": [
        "presencial",
        "online",
        "ambas"
      ]
    },
    "schedule": {
      "type": "string",
      "title": "Horarios disponibles"
    },
    "services": {
      "type": "array",
      "title": "Servicios",
      "items": {
        "type": "string"
      }
    },
    "insurers": {
      "type": "array",
      "title": "Aseguradoras aceptadas",
      "items": {
        "type": "string"
      }
    },
    "gallery": {
      "type": "array",
      "title": "Galer\u00eda de im\u00e1genes",
      "items": {
        "type": "string"
      }
    },
    "video_url": {
      "type": "string",
      "title": "Video de presentaci\u00f3n"
    },
    "certifications": {
      "type": "string",
      "title": "C\u00e9dula / Certificaciones"
    },
    "featured": {
      "type": "boolean",
      "title": "Destacado",
      "default": false
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "price_range": {
      "type": "string",
      "title": "Rango de precio",
      "enum": [
        "$",
        "$$",
        "$$$",
        "$$$$"
      ]
    },
    "professional_license_number": {
      "type": "string",
      "title": "C\u00e9dula profesional",
      "description": "N\u00famero de c\u00e9dula profesional. Debe ser \u00fanico entre todos los especialistas."
    },
    "license_verification_status": {
      "type": "string",
      "title": "Estado de verificaci\u00f3n de c\u00e9dula",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "license_verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha de verificaci\u00f3n"
    },
    "license_verified_by": {
      "type": "string",
      "title": "Verificado por (User ID)"
    },
    "publication_status": {
      "type": "string",
      "title": "Estado de publicaci\u00f3n",
      "enum": [
        "draft",
        "pending_review",
        "published",
        "suspended",
        "rejected"
      ],
      "default": "draft"
    }
  },
  "required": [
    "full_name",
    "slug",
    "specialty",
    "whatsapp"
  ],
  "uniqueFields": [
    "professional_license_number"
  ]
}