{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "image": {
      "type": "string",
      "title": "Imagen"
    },
    "excerpt": {
      "type": "string",
      "title": "Extracto"
    },
    "content": {
      "type": "string",
      "title": "Contenido"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda"
    },
    "author": {
      "type": "string",
      "title": "Autor"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta descripci\u00f3n SEO",
      "description": "Descripci\u00f3n para buscadores (160 caracteres recomendados)"
    },
    "tags": {
      "type": "array",
      "title": "Etiquetas (Tags)",
      "items": {
        "type": "string"
      },
      "description": "Palabras clave para categorizar el art\u00edculo"
    },
    "published": {
      "type": "boolean",
      "title": "Publicado",
      "default": false
    },
    "scheduled_at": {
      "type": "string",
      "title": "Publicaci\u00f3n programada",
      "description": "Fecha y hora en que se publicar\u00e1 autom\u00e1ticamente (ISO 8601)"
    },
    "featured_specialists": {
      "type": "array",
      "title": "Especialistas destacados (slugs)",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ]
}