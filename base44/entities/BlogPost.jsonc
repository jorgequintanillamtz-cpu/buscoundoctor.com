{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "image": {
      "type": "string",
      "title": "Imagen"
    },
    "excerpt": {
      "type": "string",
      "title": "Extracto"
    },
    "content": {
      "type": "string",
      "title": "Contenido"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda"
    },
    "author": {
      "type": "string",
      "title": "Autor"
    },
    "published": {
      "type": "boolean",
      "title": "Publicado",
      "default": false
    },
    "featured_specialists": {
      "type": "array",
      "title": "Especialistas destacados (slugs)",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ]
}