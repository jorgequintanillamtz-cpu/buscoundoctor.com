{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "image": {
      "type": "string",
      "title": "Imagen destacada"
    },
    "image_alt": {
      "type": "string",
      "title": "Alt text imagen"
    },
    "excerpt": {
      "type": "string",
      "title": "Extracto"
    },
    "content": {
      "type": "string",
      "title": "Contenido"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda"
    },
    "author": {
      "type": "string",
      "title": "Autor"
    },
    "meta_title": {
      "type": "string",
      "title": "Meta t\u00edtulo SEO"
    },
    "meta_description": {
      "type": "string",
      "title": "Meta descripci\u00f3n SEO"
    },
    "primary_keyword": {
      "type": "string",
      "title": "Keyword principal"
    },
    "secondary_keywords": {
      "type": "string",
      "title": "Keywords secundarias"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "published": {
      "type": "boolean",
      "title": "Publicado",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "title": "Destacado",
      "default": false
    },
    "indexable": {
      "type": "boolean",
      "title": "Indexable",
      "default": true
    },
    "schema_type": {
      "type": "string",
      "title": "Schema markup",
      "default": "Article"
    },
    "scheduled_at": {
      "type": "string",
      "title": "Publicaci\u00f3n programada"
    },
    "featured_specialists": {
      "type": "array",
      "title": "Especialistas destacados",
      "items": {
        "type": "string"
      }
    },
    "specialty_id": {
      "type": "string",
      "title": "Especialidad (relaci\u00f3n)",
      "description": "ID de registro de la entidad Specialty. Opcional: art\u00edculos generales pueden no tener especialidad asignada."
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ]
}