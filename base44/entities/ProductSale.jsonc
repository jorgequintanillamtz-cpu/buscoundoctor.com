{
  "name": "ProductSale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Producto (ref DoctorProduct)",
      "description": "ID del registro de DoctorProduct vendido."
    },
    "doctor_id": {
      "type": "string",
      "title": "Doctor (ref Specialist)",
      "description": "ID del Specialist propietario del producto."
    },
    "doctor_owner_user_id": {
      "type": "string",
      "title": "Propietario (User ID)",
      "description": "ID del User propietario del Specialist. Ancla de RLS: el doctor lee solo sus propias ventas. Lo setea createProductCheckout al resolver el Specialist."
    },
    "buyer_name": {
      "type": "string",
      "title": "Nombre del comprador"
    },
    "buyer_phone": {
      "type": "string",
      "title": "Tel\u00e9fono del comprador"
    },
    "buyer_email": {
      "type": "string",
      "title": "Email del comprador"
    },
    "amount": {
      "type": "number",
      "title": "Monto (MXN)",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "title": "Moneda",
      "default": "mxn"
    },
    "payment_status": {
      "type": "string",
      "title": "Estatus de pago",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "title": "Stripe Checkout Session ID"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "title": "Stripe Payment Intent ID"
    },
    "download_token": {
      "type": "string",
      "title": "Token de descarga",
      "description": "Token aleatorio que autoriza la descarga del archivo. Se genera al confirmar el pago."
    },
    "download_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Vencimiento del link de descarga"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha de pago"
    }
  },
  "required": [
    "product_id",
    "doctor_id",
    "doctor_owner_user_id",
    "amount",
    "payment_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.doctor_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.doctor_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.doctor_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.doctor_owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}