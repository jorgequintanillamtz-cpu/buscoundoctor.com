{
  "name": "DoctorConsultPreferences",
  "type": "object",
  "properties": {
    "doctor_id": {
      "type": "string",
      "title": "Doctor (ref Specialist)",
      "description": "ID del registro de Specialist al que pertenecen estas preferencias."
    },
    "summary_theme": {
      "type": "string",
      "title": "Dise\u00f1o del resumen",
      "enum": [
        "default",
        "handwritten_kalam",
        "handwritten_caveat"
      ],
      "default": "handwritten_caveat",
      "description": "default = dise\u00f1o cl\u00e1sico (fondo azul marino, tarjeta semitransparente, sin fuente manuscrita). handwritten_kalam = receta escrita a mano con fuente Kalam (mano imprenta). handwritten_caveat = receta escrita a mano con fuente Caveat (cursiva)."
    },
    "signature_strokes": {
      "type": "string",
      "title": "Firma del doctor (trazos JSON)",
      "description": "Trazos de la firma en formato JSON: array de strokes, cada stroke es un array de puntos {x, y} normalizados 0-1. Se anima en la p\u00e1gina p\u00fablica del resumen como si se estuviera escribiendo."
    }
  },
  "required": [
    "doctor_id",
    "summary_theme"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}